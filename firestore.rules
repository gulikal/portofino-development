rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Saytın məzmunu: hər kəs oxuya bilər, yalnız daxil olmuş admin dəyişə bilər
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Paneldən yüklənən şəkillər (hər biri maks. 1 MB)
    match /images/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

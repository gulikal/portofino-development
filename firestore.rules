rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Saytın məzmunu: hər kəs oxuya bilər, yalnız daxil olmuş admin dəyişə bilər
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Paneldən yüklənən şəkillər
    match /images/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Saytdakı müraciət forması: hər kəs yalnız YENİ müraciət yarada bilər,
    // oxumaq, dəyişmək və silmək yalnız admin üçündür
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'surname', 'phone', 'email', 'lang', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.surname is string && request.resource.data.surname.size() > 0 && request.resource.data.surname.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 25
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.status == 'new';
      allow read, update, delete: if request.auth != null;
    }
  }
}
